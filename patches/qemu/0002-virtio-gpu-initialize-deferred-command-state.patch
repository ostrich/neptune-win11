From 5dff583f6c2cf7dbad1052ed04bcab1bd1e6dd1c Mon Sep 17 00:00:00 2001
From: Neptune Patch Series <neptune@example.invalid>
Date: Fri, 25 Sep 2026 16:13:36 +0000
Subject: [PATCH 2/3] virtio-gpu: initialize deferred command state

---
 hw/display/virtio-gpu-gl.c | 1 +
 1 file changed, 1 insertion(+)

diff --git a/hw/display/virtio-gpu-gl.c b/hw/display/virtio-gpu-gl.c
index 9f104afa64..29dab4fb7b 100644
--- a/hw/display/virtio-gpu-gl.c
+++ b/hw/display/virtio-gpu-gl.c
@@ -94,6 +94,7 @@ static void virtio_gpu_gl_handle_ctrl(VirtIODevice *vdev, VirtQueue *vq)
         cmd->error = 0;
         cmd->finished = false;
         cmd->suspended = false;
+        cmd->deferred = false;
         QTAILQ_INSERT_TAIL(&g->cmdq, cmd, next);
         cmd = virtqueue_pop(vq, sizeof(struct virtio_gpu_ctrl_command));
     }
